# Adresse du Worker Cloudflare qui héberge les parties.
#
# En local, `npm run worker:dev` sert sur localhost:8787, qui est la valeur par
# défaut : ce fichier n'est pas nécessaire pour développer.
#
# En production, c'est l'URL rendue par `npm run worker:deploy`, à déclarer dans
# les variables d'environnement du projet Vercel.
NEXT_PUBLIC_PARTY_HOST=apero-party.<ton-sous-domaine>.workers.dev
